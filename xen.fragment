CONFIG_OF_LIBFDT=y
CONFIG_CMD_FDT=y
CONFIG_CMD_ECHO=y
CONFIG_DEFAULT_ENV_FILE="default_xen_env.txt"


#
# Configs copied from 'qemu-minimal.fragment' to make buildable configuration
#
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_FIT is not set
# CONFIG_FIT_SIGNATURE is not set
# CONFIG_FIT_VERBOSE is not set
# CONFIG_FIT_BEST_MATCH is not set

# CONFIG_ANDROID_PERSISTENT_RAW_DISK is not set
# CONFIG_ANDROID_PERSISTENT_RAW_DISK_DEVICE is not set

CONFIG_CMO_BY_VA_ONLY=y

CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_DEBUG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_BLOCK_COMPAT=y
CONFIG_IOMMU=y
